{
  "id": "drum-beginner-session",
  "title": "План барабанной сессии",
  "subtitle": "≈ 60 минут · уровень: начинающий",
  "blocks": [
    {
      "title": "Разминка",
      "subtitle": "5–10 мин",
      "exercises": [
        {
          "title": "Восьмые одиночными ударами",
          "instructions": "RLRL по практис-пэду или малому. Ровность и одинаковая громкость на каждой ноте.",
          "sticking": "R L R L",
          "bpm": 65,
          "timeSig": [4, 4],
          "subdivision": 2,
          "beats": ["accent", "beat", "beat", "beat"],
          "durationSec": 240,
          "tip": "Цель — настроить руки и слух на метроном."
        },
        {
          "title": "Пары RRLL",
          "instructions": "Двойные удары. Восьмые: правая-правая, левая-левая.",
          "sticking": "R R L L",
          "bpm": 65,
          "timeSig": [4, 4],
          "subdivision": 2,
          "beats": ["accent", "beat", "beat", "beat"],
          "durationSec": 240
        }
      ]
    },
    {
      "title": "Рудименты и техника",
      "subtitle": "10–15 мин · один рудимент за сессию",
      "exercises": [
        {
          "title": "Single Stroke Roll",
          "instructions": "RLRL восьмыми. 2–3 минуты на комфортном темпе → +5 BPM → ещё +5. Ровность важнее скорости.",
          "sticking": "R L R L",
          "bpm": 80,
          "timeSig": [4, 4],
          "subdivision": 2,
          "beats": ["accent", "beat", "beat", "beat"],
          "durationSec": 360,
          "tip": "Жми +5 BPM, когда уверенно играешь несколько минут."
        },
        {
          "title": "Double Stroke Roll",
          "instructions": "RRLL восьмыми. Учит руку отскакивать. 2–3 минуты на комфортном → +5 BPM → ещё +5.",
          "sticking": "R R L L",
          "bpm": 80,
          "timeSig": [4, 4],
          "subdivision": 2,
          "beats": ["accent", "beat", "beat", "beat"],
          "durationSec": 360
